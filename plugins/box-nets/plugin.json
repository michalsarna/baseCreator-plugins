{
  "format": 1,
  "id": "box-nets",
  "name": "Box nets",
  "version": "2.0.0",
  "min_base": "1.11.0",
  "author": "Michał Sarna",
  "license": "MIT OR Apache-2.0",
  "description": "The net of a box to cut out of paper or card, as one piece where the shape allows it: the outline in a continuous line, the folds dashed, with glue tabs. A prism or a truncated prism (the top slanted by up to 25 %) on a triangle, rectangle, trapezoid or regular polygon (8 sides or more), or a pyramid on a triangle or rectangle. The picture shows which length is which.",
  "programs": [
    "pencreator"
  ],
  "generators": [
    {
      "id": "box-net",
      "name": "Box net",
      "description": "The net of a box to cut out of paper or card, as one piece where the shape allows it: the outline in a continuous line, the folds dashed, with glue tabs. A prism or a truncated prism (the top slanted by up to 25 %) on a triangle, rectangle, trapezoid or regular polygon (8 sides or more), or a pyramid on a triangle or rectangle. The picture shows which length is which.",
      "script": "box.rhai",
      "params": [
        {
          "id": "base",
          "label": "Base",
          "kind": "choice",
          "default": "Rectangle",
          "options": [
            "Triangle",
            "Rectangle",
            "Trapezoid",
            "Regular polygon"
          ]
        },
        {
          "id": "solid",
          "label": "Solid (a pyramid: triangle or rectangle only)",
          "kind": "choice",
          "default": "Prism",
          "options": [
            "Prism",
            "Pyramid",
            "Truncated prism"
          ]
        },
        {
          "id": "height",
          "label": "Height h",
          "kind": "number",
          "default": 30,
          "min": 1,
          "max": 2000,
          "unit": "mm"
        },
        {
          "id": "slant",
          "label": "Slant k of the top (truncated prism)",
          "kind": "number",
          "default": 15,
          "min": 0,
          "max": 25,
          "unit": "%"
        },
        {
          "id": "tri_a",
          "label": "Triangle: side a",
          "kind": "number",
          "default": 50,
          "min": 1,
          "max": 2000,
          "unit": "mm"
        },
        {
          "id": "tri_b",
          "label": "Triangle: side b",
          "kind": "number",
          "default": 50,
          "min": 1,
          "max": 2000,
          "unit": "mm"
        },
        {
          "id": "tri_c",
          "label": "Triangle: side c",
          "kind": "number",
          "default": 50,
          "min": 1,
          "max": 2000,
          "unit": "mm"
        },
        {
          "id": "rect_w",
          "label": "Rectangle: width w",
          "kind": "number",
          "default": 60,
          "min": 1,
          "max": 2000,
          "unit": "mm"
        },
        {
          "id": "rect_d",
          "label": "Rectangle: depth d",
          "kind": "number",
          "default": 40,
          "min": 1,
          "max": 2000,
          "unit": "mm"
        },
        {
          "id": "trap_a",
          "label": "Trapezoid: bottom base a",
          "kind": "number",
          "default": 60,
          "min": 1,
          "max": 2000,
          "unit": "mm"
        },
        {
          "id": "trap_b",
          "label": "Trapezoid: top base b",
          "kind": "number",
          "default": 30,
          "min": 1,
          "max": 2000,
          "unit": "mm"
        },
        {
          "id": "trap_d",
          "label": "Trapezoid: depth d",
          "kind": "number",
          "default": 40,
          "min": 1,
          "max": 2000,
          "unit": "mm"
        },
        {
          "id": "poly_n",
          "label": "Polygon: number of sides n (8 or more)",
          "kind": "number",
          "default": 8,
          "min": 8,
          "max": 60
        },
        {
          "id": "poly_side",
          "label": "Polygon: side length s",
          "kind": "number",
          "default": 25,
          "min": 1,
          "max": 1000,
          "unit": "mm"
        },
        {
          "id": "tab",
          "label": "Glue tab width",
          "kind": "number",
          "default": 8,
          "min": 2,
          "max": 50,
          "unit": "mm"
        },
        {
          "id": "dash",
          "label": "Dash of the fold lines",
          "kind": "number",
          "default": 4,
          "min": 0.5,
          "max": 50,
          "unit": "mm"
        },
        {
          "id": "dash_gap",
          "label": "Gap of the fold lines",
          "kind": "number",
          "default": 2,
          "min": 0.2,
          "max": 50,
          "unit": "mm"
        },
        {
          "id": "space",
          "label": "Space between separate pieces",
          "kind": "number",
          "default": 10,
          "min": 1,
          "max": 200,
          "unit": "mm"
        },
        {
          "id": "cut_layer",
          "label": "Layer of the outline",
          "kind": "number",
          "default": 0,
          "min": 0,
          "max": 15
        },
        {
          "id": "fold_layer",
          "label": "Layer of the folds",
          "kind": "number",
          "default": 1,
          "min": 0,
          "max": 15
        }
      ],
      "figures": [
        {
          "when": {
            "base": "Triangle",
            "solid": "Prism"
          },
          "file": "figures/triangle-prism.svg"
        },
        {
          "when": {
            "base": "Triangle",
            "solid": "Pyramid"
          },
          "file": "figures/triangle-pyramid.svg"
        },
        {
          "when": {
            "base": "Triangle",
            "solid": "Truncated prism"
          },
          "file": "figures/triangle-truncated-prism.svg"
        },
        {
          "when": {
            "base": "Rectangle",
            "solid": "Prism"
          },
          "file": "figures/rectangle-prism.svg"
        },
        {
          "when": {
            "base": "Rectangle",
            "solid": "Pyramid"
          },
          "file": "figures/rectangle-pyramid.svg"
        },
        {
          "when": {
            "base": "Rectangle",
            "solid": "Truncated prism"
          },
          "file": "figures/rectangle-truncated-prism.svg"
        },
        {
          "when": {
            "base": "Trapezoid",
            "solid": "Prism"
          },
          "file": "figures/trapezoid-prism.svg"
        },
        {
          "when": {
            "base": "Trapezoid",
            "solid": "Truncated prism"
          },
          "file": "figures/trapezoid-truncated-prism.svg"
        },
        {
          "when": {
            "base": "Regular polygon",
            "solid": "Prism"
          },
          "file": "figures/regular-polygon-prism.svg"
        },
        {
          "when": {
            "base": "Regular polygon",
            "solid": "Truncated prism"
          },
          "file": "figures/regular-polygon-truncated-prism.svg"
        },
        {
          "when": {
            "base": "Trapezoid",
            "solid": "Pyramid"
          },
          "file": "figures/trapezoid-prism.svg"
        },
        {
          "when": {
            "base": "Regular polygon",
            "solid": "Pyramid"
          },
          "file": "figures/regular-polygon-prism.svg"
        }
      ]
    }
  ],
  "texts": {
    "pl": {
      "Box net": "Siatka pudełka",
      "Base": "Podstawa",
      "Triangle": "Trójkąt",
      "Rectangle": "Prostokąt",
      "Trapezoid": "Trapez",
      "Regular polygon": "Wielokąt foremny",
      "Solid (a pyramid: triangle or rectangle only)": "Bryła (ostrosłup: tylko trójkąt lub prostokąt)",
      "Prism": "Graniastosłup",
      "Pyramid": "Ostrosłup",
      "Truncated prism": "Graniastosłup ścięty",
      "Triangle: side a": "Trójkąt: bok a",
      "Triangle: side b": "Trójkąt: bok b",
      "Triangle: side c": "Trójkąt: bok c",
      "Glue tab width": "Szerokość zakładki do klejenia",
      "Dash of the fold lines": "Kreska linii zgięcia",
      "Gap of the fold lines": "Przerwa linii zgięcia",
      "Layer of the outline": "Warstwa obrysu",
      "Layer of the folds": "Warstwa zgięć",
      "The three sides do not make a triangle": "Te trzy boki nie tworzą trójkąta",
      "A pyramid stands on a triangle or a rectangle only: a prism is made": "Ostrosłup może stać tylko na trójkącie lub prostokącie: powstaje graniastosłup",
      "Box nets": "Siatki pudełek",
      "Height h": "Wysokość h",
      "Slant k of the top (truncated prism)": "Skos k góry (graniastosłup ścięty)",
      "Rectangle: width w": "Prostokąt: szerokość w",
      "Rectangle: depth d": "Prostokąt: głębokość d",
      "Trapezoid: bottom base a": "Trapez: dolna podstawa a",
      "Trapezoid: top base b": "Trapez: górna podstawa b",
      "Trapezoid: depth d": "Trapez: wysokość trapezu d",
      "Polygon: number of sides n (8 or more)": "Wielokąt: liczba boków n (od 8)",
      "Polygon: side length s": "Wielokąt: długość boku s",
      "Space between separate pieces": "Odstęp między osobnymi elementami",
      "The net of a box to cut out of paper or card, as one piece where the shape allows it: the outline in a continuous line, the folds dashed, with glue tabs. A prism or a truncated prism (the top slanted by up to 25 %) on a triangle, rectangle, trapezoid or regular polygon (8 sides or more), or a pyramid on a triangle or rectangle. The picture shows which length is which.": "Siatka pudełka do wycięcia z papieru lub kartonu, w jednym kawałku, gdy kształt na to pozwala: obrys linią ciągłą, zgięcia przerywaną, z zakładkami do klejenia. Graniastosłup lub graniastosłup ścięty (góra skośna do 25 %) na trójkącie, prostokącie, trapezie lub wielokącie foremnym (od 8 boków) albo ostrosłup na trójkącie lub prostokącie. Rysunek pokazuje, która długość jest która.",
      "The base could not be folded on to the sides without overlaps: it is a separate piece": "Podstawy nie dało się dołączyć do ścian bez nakładania: jest osobnym elementem",
      "The bottom could not be folded on to the sides without overlaps: it is a separate piece": "Spodu nie dało się dołączyć do ścian bez nakładania: jest osobnym elementem",
      "The top could not be folded on to the sides without overlaps: it is a separate piece": "Góry nie dało się dołączyć do ścian bez nakładania: jest osobnym elementem",
      "The outline of the net crosses itself (the shape is too flat or too sharp to unfold in one piece)": "Obrys siatki przecina się sam (bryła jest zbyt płaska lub zbyt ostra, by rozłożyć ją w jednym kawałku)"
    }
  }
}
