{
  "format": 1,
  "id": "box-nets",
  "name": "Box nets",
  "version": "2.3.1",
  "min_base": "1.12.0",
  "author": "Michał Sarna",
  "license": "MIT OR Apache-2.0",
  "description": "The net of a box to cut out of paper or card, as one piece where the shape allows it: the outline in a continuous line, the folds dashed, with glue tabs. A prism or a truncated prism (the top slanted by up to 25 %) on a triangle, rectangle, trapezoid or regular polygon (8 sides or more), or a pyramid on a triangle or rectangle; on a circle or an ellipse the prism is a cylinder, the truncated one a cylinder cut slantways, the pyramid a cone and the truncated pyramid a truncated cone. The picture shows which length is which.",
  "programs": [
    "pencreator"
  ],
  "generators": [
    {
      "id": "box-net",
      "name": "Box net",
      "description": "The net of a box to cut out of paper or card, as one piece where the shape allows it: the outline in a continuous line, the folds dashed, with glue tabs. A prism or a truncated prism (the top slanted by up to 25 %) on a triangle, rectangle, trapezoid or regular polygon (8 sides or more), or a pyramid on a triangle or rectangle; on a circle or an ellipse the prism is a cylinder, the truncated one a cylinder cut slantways, the pyramid a cone and the truncated pyramid a truncated cone. The picture shows which length is which.",
