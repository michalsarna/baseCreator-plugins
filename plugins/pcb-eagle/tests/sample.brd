<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<eagle version="9.6.2">
<drawing>
<settings>
<setting alwaysvectorfont="no"/>
</settings>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="15" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="37" y2="0" width="0.1" layer="20"/>
<wire x1="37" y1="0" x2="40" y2="3" width="0.1" layer="20" curve="90"/>
<wire x1="40" y1="3" x2="40" y2="25" width="0.1" layer="20"/>
<wire x1="40" y1="25" x2="0" y2="25" width="0.1" layer="20"/>
<wire x1="0" y1="25" x2="0" y2="0" width="0.1" layer="20"/>
<circle x="36" y="4" radius="1.5" width="0.15" layer="21"/>
<hole x="3" y="22" drill="3"/>
<text x="10" y="20" size="1.27" layer="21">Hello &gt; world</text>
</plain>
<libraries>
<library name="rcl">
<packages>
<package name="R0805">
<description>Resistor &lt;b&gt;0805&lt;/b&gt;</description>
<wire x1="-1.5" y1="-1" x2="1.5" y2="-1" width="0.12" layer="21"/>
<smd name="1" x="-1" y="0" dx="1" dy="1.3" layer="1" roundness="25"/>
<smd name="2" x="1" y="0" dx="1" dy="1.3" layer="1" rot="R90"/>
</package>
</packages>
</library>
<library name="con">
<packages>
<package name="PIN2">
<pad name="1" x="0" y="0" drill="1" diameter="1.8" shape="square"/>
<pad name="2" x="0" y="2.54" drill="1" shape="long" rot="R90"/>
</package>
</packages>
</library>
</libraries>
<elements>
<element name="R1" library="rcl" package="R0805" value="10k" x="10" y="20" rot="R90"/>
<element name="J1" library="con" package="PIN2" value="" x="25" y="13"/>
<element name="R2" library="rcl" package="R0805" value="1k" x="30" y="20" rot="MR0"/>
</elements>
<signals>
<signal name="VCC">
<contactref element="R1" pad="1"/>
<wire x1="9" y1="20" x2="9" y2="13" width="0.3" layer="1"/>
<wire x1="9" y1="13" x2="25" y2="13" width="0.3" layer="1"/>
<wire x1="25" y1="13" x2="27" y2="11" width="0.3" layer="1" curve="-90"/>
<via x="27" y="5" extent="1-16" drill="0.4"/>
<polygon width="0.3" layer="1" isolate="0.3">
<vertex x="30" y="2"/>
<vertex x="38" y="2"/>
<vertex x="38" y="8"/>
</polygon>
</signal>
</signals>
</board>
</drawing>
</eagle>
