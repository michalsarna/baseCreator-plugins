{
  "format": 1,
  "id": "pcb-kicad",
  "name": "Circuit board: KiCad",
  "version": "1.0.1",
  "min_base": "1.15.0",
  "author": "Michał Sarna",
  "license": "MIT OR Apache-2.0",
  "description": "Reads a KiCad board (.kicad_pcb, KiCad 5 to 8): the board outline, copper (tracks, pads, vias, filled zones), drill holes and the silkscreen, each part ticked in the form. For isolation milling, laser engraving of a resist or plotting of the traces.",
  "importers": [
    {
      "id": "kicad-pcb",
      "name": "KiCad board (.kicad_pcb)",
      "extensions": [
        "kicad_pcb"
      ],
      "script": "read.rhai",
      "params": [
        {
          "id": "outline",
          "label": "Board outline (Edge.Cuts)",
          "kind": "bool",
          "default": true
        },
        {
          "id": "copper_top",
          "label": "Copper on top",
          "kind": "bool",
          "default": true
        },
        {
          "id": "copper_bottom",
          "label": "Copper on the bottom",
          "kind": "bool",
          "default": false
        },
        {
          "id": "holes",
          "label": "Drill holes",
          "kind": "bool",
          "default": true
        },
        {
          "id": "legend_top",
          "label": "Legend on top",
          "kind": "bool",
          "default": false
        },
        {
          "id": "legend_bottom",
          "label": "Legend on the bottom",
          "kind": "bool",
          "default": false
        },
        {
          "id": "mirror",
          "label": "Mirror (a bottom layer seen from the top)",
          "kind": "bool",
          "default": false
        },
        {
          "id": "origin",
          "label": "Origin",
          "kind": "choice",
          "default": "Board corner to the top left",
          "options": [
            "As in the file",
            "Board corner to the top left"
          ]
        },
        {
          "id": "mode",
          "label": "Copper drawn as",
          "kind": "choice",
          "default": "Outlines grown by the isolation",
          "options": [
            "Centre lines",
            "Outlines grown by the isolation"
          ]
        },
        {
          "id": "isolation",
          "label": "Isolation",
          "kind": "number",
          "default": 0.2,
          "min": 0,
          "max": 5,
          "unit": "mm"
        },
        {
          "id": "holes_as",
          "label": "Holes drawn as",
          "kind": "choice",
          "default": "Circles of the real size",
          "options": [
            "Circles of the real size",
            "Small circles at the centres"
          ]
        },
        {
          "id": "layer_outline",
          "label": "Layer of the board outline",
          "kind": "number",
          "default": 0,
          "min": 0,
          "max": 20,
          "unit": ""
        },
        {
          "id": "layer_copper",
          "label": "Layer of the copper",
          "kind": "number",
          "default": 1,
          "min": 0,
          "max": 20,
          "unit": ""
        },
        {
          "id": "layer_holes",
          "label": "Layer of the drill holes",
          "kind": "number",
          "default": 2,
          "min": 0,
          "max": 20,
          "unit": ""
        },
        {
          "id": "layer_legend",
          "label": "Layer of the legend",
          "kind": "number",
          "default": 3,
          "min": 0,
          "max": 20,
          "unit": ""
        }
      ]
    }
  ],
